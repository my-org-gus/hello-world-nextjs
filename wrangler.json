{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextjs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "replace-after-deploy"
    },
    {
      "binding": "GALLERY_KV",
      "id": "replace-after-deploy-gallery"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY_R2",
      "bucket_name": "kalko-gallery"
    }
  ]
}
